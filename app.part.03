mt(x.ValuePerLevel*100)}%</div><div class="controls"><button data-d="-1">-1</button><button data-d="1">+1</button><button data-d="5">+5</button><button data-d="max">MAX</button></div></div>`}).join('')}</div>`;e.onclick=ev=>{let b=ev.target.closest('[data-tech] button');if(!b)return;let card=b.closest('[data-tech]'),k=card.dataset.tech,x=lib[k],cur=num(S.clanTech[k]),d=b.dataset.d;S.clanTech[k]=d==='max'?x.MaxLevel:Math.max(0,Math.min(x.MaxLevel,cur+num(d)));save();clantech()}}
const WMAP={ForgePrimitiveEquipment:['원시 장비 제작','WarPointsFromForging'],ForgeMedievalEquipment:['중세 장비 제작','WarPointsFromForging'],ForgeEarlyModernEquipment:['근세 장비 제작','WarPointsFromForging'],ForgeModernEquipment:['현대 장비 제작','WarPointsFromForging'],ForgeSpaceEquipment:['우주 장비 제작','WarPointsFromForging'],ForgeInterstellarEquipment:['성간 장비 제작','WarPointsFromForging'],ForgeMultiverseEquipment:['다중우주 장비 제작','WarPointsFromForging'],ForgeQuantumEquipment:['양자 장비 제작','WarPointsFromForging'],ForgeUnderworldEquipment:['지하세계 장비 제작','WarPointsFromForging'],ForgeDivineEquipment:['신성 장비 제작','WarPointsFromForging'],UseHammerThiefDungeonKey:['망치 도둑 열쇠','WarPointsFromDungeonKey'],UseGhostTownDungeonKey:['유령 마을 열쇠','WarPointsFromDungeonKey'],UseInvasionDungeonKey:['침공 열쇠','WarPointsFromDungeonKey'],UseZombieInvasionDungeonKey:['좀비 침공 열쇠','WarPointsFromDungeonKey'],SpendCoinsOnForge:['대장간 코인 사용','WarPointsFromForgeSpend'],SpendGemOnForge:['대장간 보석 사용','WarPointsFromForgeSpend']};
function taskLabel(t){if(WMAP[t])return WMAP[t];let r=['Common','Rare','Epic','Legendary','Ultimate','Mythic'].find(x=>t.includes(x)),ko=RKO[r]||'';if(t.startsWith('Summon')&&t.endsWith('Skill'))return[ko+' 스킬 소환','WarPointsFromSkillSummon'];if(t.startsWith('Upgrade')&&t.endsWith('Skill'))return[ko+' 스킬 강화','WarPointsFromSkillUpgrade'];if(t.startsWith('Hatch')&&t.endsWith('Egg'))return[ko+' 알 부화','WarPointsFromEggHatch'];if(t.startsWith('Merge')&&t.endsWith('Pet'))return[ko+' 펫 합성','WarPointsFromPetMerge'];if(t.startsWith('Summon')&&t.endsWith('Mount'))return[ko+' 탈것 소환','WarPointsFromMountSummon'];if(t.startsWith('Merge')&&t.endsWith('Mount'))return[ko+' 탈것 합성','WarPointsFromMountMerge'];if(t.startsWith('Finish')){let roman={I:'Ⅰ',II:'Ⅱ',III:'Ⅲ',IV:'Ⅳ',V:'Ⅴ'};let z=t.match(/Finish(I|II|III|IV|V)Tech/);return[(roman[z?.[1]]||'')+' 기술 연구 완료','WarPointsFromTechUpgrade']}return[t,'']}
async function guildwar(){let e=$('#app'),lib=await j(`${CFG}/GuildWarDayConfigLibrary.json`),day=Math.max(1,Math.min(5,num(S.war.day,1)));function bonus(k){let x=num(S.clanTech[k]);return Math.min(10,x)*.04}function render(){let row=lib[String(day-1)],tasks=row.Tasks||[],dayB=bonus('WarPointsOnDay'+day),total=0;e.innerHTML=`<div class="hero"><span class="chip">클랜전</span><h1>${day}일차 점수 계산</h1><p class="muted">실제 2.9.0 일차별 행동과 클랜 점수 기술을 적용합니다.</p></div><div class="tabs">${[1,2,3,4,5].map(d=>`<button data-day="${d}" class="${d===day?'active':''}">${d}일차</button>`).join('')}</div><div class="panel"><div class="scoreList">${tasks.map(x=>{let [label,key]=taskLabel(x.Task),base=x.Rewards?.find(r=>r.$type==='WarPointsReward')?.Amount||0,count=num(S.war.counts[day+':'+x.Task]),b=bonus(key)+dayB,per=base*(1+b),sum=Math.round(count*per);total+=sum;return `<div class="scoreRow"><div><b>${esc(label)}</b><small>기본 ${fmt(base)} · 기술 +${Math.round(b*100)}%</small></div><div><small>1회</small><b>${fmt(per)}</b></div><label class="field"><span>개수</span><input data-count="${esc(x.Task)}" type="number" min="0" value="${count||''}"></label><div><small>총점</small><b>${fmt(sum)}</b></div><div class="muted small">${esc(key||'')}</div></div>`}).join('')}</div><div class="panel"><small>일차 총점</small><div class="sum">${fmt(total)}</div></div></div>`;e.onclick=ev=>{let b=ev.target.closest('[data-day]');if(b){day=+b.dataset.day;S.war.day=day;save();render()}};e.oninput=ev=>{if(ev.target.dataset.count){S.war.counts[day+':'+ev.target.dataset.count]=Math.max(0,num(ev.target.value));save();render()}}}render()}
async function techtree(){let e=$('#app');e.innerHTML=`<div class="hero"><span class="chip">기술</span><h1>기술 트리</h1><p class="muted">새 KR판의 기술 트리는 1vcian 최�