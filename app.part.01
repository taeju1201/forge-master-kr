;$('#shade').classList.toggle('show',!!v)}
async function go(id){location.hash='#/'+id;drawer(0);$$('.navBtn').forEach(b=>b.classList.toggle('active',b.dataset.page===id));$('#app').innerHTML='<div class="loading">불러오는 중...</div>';try{await(pages[id]||pages.home)()}catch(e){console.error(e);$('#app').innerHTML=`<div class="panel"><h2>오류</h2><div class="muted">${esc(e.message)}</div></div>`}}
const spriteStyle=(texture,index,cols,cell,size=78)=>{let col=index%cols,row=Math.floor(index/cols),scale=size/cell;return `background-image:url('${texture}');background-size:${cols*cell*scale}px auto;background-position:-${col*cell*scale}px -${row*cell*scale}px`};
async function home(){let e=$('#app');e.innerHTML=`<div class="hero"><span class="chip">Forge Master 2.9.0</span><h1>Forge Master KR</h1><p class="muted">1vcian의 최신 게임 데이터 구조를 기준으로 새로 만든 한국어 모바일 플래너. 기존 KR 기능은 백업하고 시스템을 새로 구성했습니다.</p></div><div class="g4 grid panel">${[['profile','👤','프로필'],['items','⚔️','장비'],['fairies','🧚','요정'],['guildwar','🏰','클랜전'],['pets','🐾','펫'],['mounts','🐎','탈것'],['skills','✨','스킬'],['clantech','🛡️','클랜 기술']].map(([id,ic,nm])=>`<button class="btn" data-go="${id}">${ic}<br>${nm}</button>`).join('')}</div><div class="notice">폰트는 설치된 <b>빛의 계승자</b>를 우선 사용합니다. 제공받은 폰트 파일 자체는 사이트에 재배포하지 않습니다.</div>`;e.onclick=x=>{let b=x.target.closest('[data-go]');if(b)go(b.dataset.go)}}
async function profile(){let e=$('#app');e.innerHTML=`<div class="hero"><span class="chip">프로필</span><h1>내 설정</h1><p class="muted">장비·펫·탈것·스킬·요정·클랜 기술이 계산기에 공통 적용됩니다.</p></div><div class="panel g2 grid"><label class="field"><span>이름</span><input id="pn" value="${esc(S.name)}"></label>${Object.entries(S.resources).map(([k,v])=>`<label class="field"><span>${{Coins:'코인',SkillSummonTickets:'스킬 티켓',Eggshells:'에그셸',TechPotions:'기술 포션',ClockWinders:'탈것 열쇠'}[k]}</span><input data-res="${k}" type="number" min="0" value="${v}"></label>`).join('')}</div><div class="panel"><button class="btn red" id="reset">새 KR 설정 초기화</button></div>`;e.oninput=ev=>{if(ev.target.id==='pn')S.name=ev.target.value;if(ev.target.dataset.res)S.resources[ev.target.dataset.res]=Math.max(0,num(ev.target.value));save()};$('#reset').onclick=()=>{if(confirm('새 KR 저장값을 초기화할까?')){S=structuredClone(defaults);save();profile()}}}
async function items(){let e=$('#app'),[map,lib]=await Promise.all([j(`${RAW}/parsed_configs/AutoItemMapping.json`),j(`${CFG}/ItemBalancingLibrary.json`)]);let age=S.item.age,type=S.item.type,level=S.item.level||1;function render(){let rows=Object.entries(map).filter(([,x])=>x.Age===age&&x.TypeName===type).sort((a,b)=>a[1].Idx-b[1].Idx);e.innerHTML=`<div class="hero"><span class="chip">장비 도감</span><h1>장비</h1><p class="muted">실제 인게임 아이콘 매핑과 2.9.0 장비 데이터를 사용합니다.</p></div><div class="tabs">${AGE.map((x,i)=>`<button data-age="${i}" class="${i===age?'active':''}">${x}</button>`).join('')}</div><div class="tabs">${Object.entries(SLOT).map(([k,v])=>`<button data-type="${k}" class="${k===type?'active':''}">${v}</button>`).join('')}</div><div class="panel g2 grid"><label class="field"><span>표시 레벨</span><input id="ilevel" type="range" min="1" max="120" value="${level}"></label><div class="metric"><small>현재 레벨</small><b>Lv.${level}</b></div></div><div class="cards">${rows.map(([key,x])=>{let cfg=lib[`{'Age': ${x.Age}, 'Type': '${x.TypeName}', 'Idx': ${x.Idx}}`],stats=(cfg?.EquipmentStats||[]).map(s=>{let t=s.StatNode?.UniqueStat?.StatType,val=num(s.Value)*Math.pow(1.01,level-1);return `${t==='Damage'?'피해':'체력'} ${fmt(val)}`}).join(' · ');return `<div class="card media"><img class="art" src="${GTEX}/items/${x.SpriteName}.png" alt=""><div><b>${AGE[age]} ${SLOT[type]} ${x.Idx+1}</b><div class="muted small">${esc(x.ItemName)}</div><div>${stats||'스탯 정보 없음'}</div></div></div>`}).join('')}</div>`;e.onclick=ev=>{let a=ev.target.closest('[data-age]'),t=ev.target.closest('[data-type]');if(a){age=+a.dataset.age;S.item.age=age;save();render()}if(t){type=t.dataset.type;S.item.type=type;save();render()}};$('#ilevel').oninput=ev=>{level=+ev.target.va