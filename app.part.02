lue;S.item.level=level;save();render()}}render()}
async function companions(kind){let e=$('#app'),m=await j(`${RAW}/parsed_configs/ManualSpriteMapping.json`),cfg=m[kind],mapping=Object.entries(cfg.mapping),ko=kind==='pets'?PET_KO:kind==='mounts'?MOUNT_KO:SKILL_KO,tex=kind==='pets'?'Pets.png':kind==='mounts'?'MountIcons.png':'SkillIcons.png';e.innerHTML=`<div class="hero"><span class="chip">도감</span><h1>${kind==='pets'?'펫':kind==='mounts'?'탈것':'스킬'}</h1><p class="muted">인게임 스프라이트 시트를 그대로 사용합니다.</p></div><div class="cards">${mapping.map(([idx,x])=>`<div class="card media"><div class="sprite rarity-${x.rarity||''}" style="${spriteStyle(`${TEX}/${tex}`,+idx,cfg.grid.columns,cfg.sprite_size.width)}"></div><div><b>${esc(ko[x.name]||x.name)}</b><div class="muted small">${x.rarity?RKO[x.rarity]||x.rarity:''}${x.id!=null?' · #'+x.id:''}</div></div></div>`).join('')}</div>`}
async function pets(){return companions('pets')}async function mounts(){return companions('mounts')}async function skills(){return companions('skills')}
const FAIRY={Lora:{need:'체력',div:.10,gain:'반사 확률',step:.0075,cap:.30},Mira:{need:'스킬 피해',div:.15,gain:'치명타 확률',step:.01,cap:.80},Tira:{need:'스킬 쿨다운 감소',div:.01,gain:'막기 확률',step:.0025,cap:.30}};
async function fairies(){let e=$('#app'),up=await j(`${CFG}/FairyUpgradesLibrary.json`),lv=Math.max(1,Math.min(20,num(S.fairy.level,1))),sel=S.fairy.name;let costs=Object.values(up).filter(x=>x.Level<=lv);let total={};for(const x of costs)for(const c of x.Costs)total[c.Currency]=(total[c.Currency]||0)+c.Amount;function render(){e.innerHTML=`<div class="hero"><span class="chip">2.9.0 신규</span><h1>요정</h1><p class="muted">시즌형 요정 시스템. 선택핔 요정과 레벨 효과를 프로필에 적용합니다.</p></div><div class="tabs"><button data-fairy="" class="${!sel?'active':''}">없음</button>${['Lora','Mira','Tira'].map(n=>`<button data-fairy="${n}" class="${sel===n?'active':''}">${n}</button>`).join('')}</div><div class="panel g2 grid"><label class="field"><span>요정 레벨</span><input id="flv" type="range" min="1" max="20" value="${lv}"></label><div class="metric"><small>현재</small><b>Lv.${lv}/20</b></div></div><div class="cards">${['Lora','Mira','Tira'].map(n=>{let f=FAIRY[n],per=f.step*lv;return `<div class="card"><img class="fairyArt" src="${TEX}/FairyIcon${n}.png"><h2>${n}</h2><div class="muted small">${f.need} ${Math.round(f.div*10000)/100}%마다</div><div>+${Math.round(per*10000)/100}% ${f.gain}</div><div class="muted small">최대 +${f.cap*100}%</div></div>`}).join('')}</div><div class="panel"><h2>Lv.${lv}까지 강화 비용</h2><div class="g3 grid">${Object.entries(total).map(([k,v])=>`<div class="metric"><small>${{Coins:'코인',SkillSummonTickets:'스킬 티켓',Eggshells:'에그셸',TechPotions:'기술 포션',ClockWinders:'탈것 열쇠'}[k]||k}</small><b>${fmt(v)}</b></div>`).join('')}</div><p class="muted small">각 레벨은 5개 재화 중 하나를 선택해서 지불하는 구조라 총합은 재화별 대체 비용입니다.</p></div>`;e.onclick=ev=>{let b=ev.target.closest('[data-fairy]');if(b){sel=b.dataset.fairy||null;S.fairy.name=sel;save();render()}};$('#flv').oninput=ev=>{S.fairy.level=+ev.target.value;save();fairies()}}render()}
const WT=[['WarPointsFromForging','장비 제작 점수'],['WarPointsFromSkillSummon','스킬 소환 점수'],['WarPointsFromSkillUpgrade','스킬 강화 점수'],['WarPointsFromTechUpgrade','기술 연구 점수'],['WarPointsFromForgeSpend','대장간 재화 점수'],['WarPointsFromDungeonKey','던전 열쇠 점수'],['WarPointsFromEggHatch','알 부화 점수'],['WarPointsFromPetMerge','펫 합성 점수'],['WarPointsFromMountSummon','탈것 소환 점수'],['WarPointsFromMountMerge','탈것 합성 점수'],...Array.from({length:5},(_,i)=>['WarPointsOnDay'+(i+1),(i+1)+'일차 전체 점수'])];
async function clantech(){let e=$('#app'),lib=await j(`${CFG}/GuildTechTreeUpgradeLibrary.json`);e.innerHTML=`<div class="hero"><span class="chip">클랜</span><h1>클랜 기술</h1><p class="muted">2.9.0 실제 쵀대레벨과 레벨당 효과를 사용합니다.</p></div><div class="cards">${Object.entries(lib).map(([k,x])=>{let lv=Math.max(0,Math.min(x.MaxLevel,num(S.clanTech[k])));return `<div class="card techCard" data-tech="${k}"><b>${esc(WT.find(a=>a[0]===k)?.[1]||k)}</b><div class="muted small">Lv.${lv}/${x.MaxLevel} · 레벨당 ${f